{
"manifest_version": 3,
"name": "Fake News Detector",
"version": "1.0",

"description": "Detects fake news using Machine Learning.",

"permissions": [
    "activeTab",
    "scripting"
],

"host_permissions": [
    "http://127.0.0.1:5000/*"
],

"action": {
    "default_popup": "popup.html"
},

"content_scripts": [
    {
    "matches": [
        "<all_urls>"
    ],
    "js": [
        "content.js"
    ]
    }
]
}